# Supabase connection for the live booking + admin backend.
# Copy this file to `.env` and fill in the values from your Supabase project
# (Dashboard → Project Settings → API). The anon key is safe for the browser;
# row access is governed by the RLS policies in supabase/schema.sql.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
